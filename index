<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Doctor Nowhere - Night Guard</title>
<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        user-select: none;
    }
    body {
        background-color: #000;
        color: #fff;
        font-family: 'Courier New', Courier, monospace;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        overflow: hidden;
    }

    #game-container {
        position: relative;
        width: 1000px;
        height: 650px;
        background: #050505;
        border: 4px solid #1f1f1f;
        box-shadow: 0 0 35px rgba(150, 0, 0, 0.3);
        overflow: hidden;
    }

    /* Efecto VHS */
    .scanlines {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.6) 50%);
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 50;
    }

    /* OFICINA */
    #office-view {
        position: absolute;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at center, #151010 0%, #020202 85%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .office-walls {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .door-frame {
        width: 280px;
        height: 100%;
        background: #0a0a0a;
        border: 4px solid #1a1a1a;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .door-light {
        width: 100%;
        height: 100%;
        background: transparent;
        transition: background 0.1s;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .door-light.on {
        background: rgba(255, 200, 150, 0.15);
        box-shadow: inset 0 0 80px rgba(255, 180, 80, 0.2);
    }

    .door-closed-graphic {
        position: absolute;
        top: -100%;
        left: 0; width: 100%; height: 100%;
        background: linear-gradient(180deg, #222, #080808);
        border-bottom: 8px solid #444;
        transition: top 0.2s ease-in-out;
        z-index: 10;
    }

    .door-closed-graphic.closed {
        top: 0;
    }

    .monster-img {
        display: none;
        max-width: 95%;
        max-height: 85%;
        object-fit: contain;
        filter: drop-shadow(0 0 15px #ff0000) contrast(1.2);
        z-index: 5;
    }

    /* MONITOR DE CÁMARAS PANTALLA COMPLETA */
    #camera-view {
        display: none;
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: #000;
        z-index: 20;
    }

    #cam-feed {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
    }

    .cam-monster-img {
        display: none;
        width: 85%;
        height: 85%;
        object-fit: contain;
        filter: contrast(1.4) brightness(0.85);
    }

    .cam-map {
        position: absolute;
        bottom: 70px; right: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: rgba(0,0,0,0.85);
        padding: 12px;
        border: 1px solid #333;
        z-index: 22;
    }

    .cam-btn {
        background: #111;
        color: #fff;
        border: 1px solid #444;
        padding: 10px 16px;
        font-size: 0.9rem;
        cursor: pointer;
        font-family: inherit;
    }

    .cam-btn.active {
        background: #990000;
        color: #fff;
        font-weight: bold;
    }

    /* HUD */
    #hud {
        position: absolute;
        top: 20px; left: 20px;
        z-index: 30;
        font-size: 1.1rem;
        color: #ff3333;
        text-shadow: 1px 1px 4px #000;
    }

    #time-display {
        position: absolute;
        top: 20px; right: 20px;
        z-index: 30;
        font-size: 1.3rem;
        color: #fff;
        font-weight: bold;
    }

    #bottom-bar {
        position: absolute;
        bottom: 0; left: 0; width: 100%;
        height: 60px;
        background: rgba(10, 10, 10, 0.95);
        border-top: 2px solid #222;
        display: flex;
        justify-content: space-around;
        align-items: center;
        z-index: 35;
    }

    .ctrl-btn {
        background: #151515;
        color: #fff;
        border: 1px solid #444;
        padding: 10px 18px;
        font-family: inherit;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .ctrl-btn:hover { background: #2a2a2a; }

    /* JUMPSCARE */
    #jumpscare-screen {
        display: none;
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: #000;
        z-index: 100;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    #jumpscare-img {
        width: 100%;
        height: 80%;
        object-fit: contain;
        animation: shake 0.03s infinite alternate;
    }

    @keyframes shake {
        0% { transform: scale(1.15) translate(-15px, 15px); filter: contrast(2.5) hue-rotate(0deg); }
        100% { transform: scale(1.25) translate(15px, -15px); filter: contrast(3.5) hue-rotate(30deg); }
    }
</style>
</head>
<body>

<div id="game-container">
    <div class="scanlines"></div>

    <div id="hud">
        BATERÍA: <span id="power-val">100%</span> | USO: <span id="usage-val">BAJO</span>
    </div>
    <div id="time-display"><span id="hour-val">12</span> AM (NOCHE 1)</div>

    <!-- OFICINA -->
    <div id="office-view">
        <div class="office-walls">
            <!-- PUERTA IZQUIERDA (THE BOILED ONE) -->
            <div class="door-frame">
                <div class="door-closed-graphic" id="door-left"></div>
                <div class="door-light" id="light-left">
                    <img id="monster-left" class="monster-img" src="" alt="The Boiled One">
                </div>
            </div>

            <!-- PUERTA DERECHA (THE LOCUST) -->
            <div class="door-frame">
                <div class="door-closed-graphic" id="door-right"></div>
                <div class="door-light" id="light-right">
                    <img id="monster-right" class="monster-img" src="" alt="The Locust">
                </div>
            </div>
        </div>

        <div id="bottom-bar">
            <button class="ctrl-btn" onclick="toggleDoor('left')">Puerta Izq (L)</button>
            <button class="ctrl-btn" onclick="toggleLight('left')">Luz Izq (Q)</button>
            <button class="ctrl-btn" style="background: #440000; border-color:#880000; font-weight: bold;" onclick="toggleMonitor()">MONITOR DE CÁMARAS (ESPACIO)</button>
            <button class="ctrl-btn" onclick="toggleLight('right')">Luz Der (E)</button>
            <button class="ctrl-btn" onclick="toggleDoor('right')">Puerta Der (R)</button>
        </div>
    </div>

    <!-- CÁMARAS -->
    <div id="camera-view">
        <div id="cam-feed">
            <img id="cam-monster-img" class="cam-monster-img" src="" alt="Cámara">
        </div>
        <div class="cam-map">
            <button class="cam-btn active" onclick="switchCam(1)">CAM 01 (Izq)</button>
            <button class="cam-btn" onclick="switchCam(2)">CAM 02 (Der)</button>
        </div>
        <button class="ctrl-btn" style="position: absolute; bottom: 20px; left: 20px; z-index: 25; background: #222;" onclick="toggleMonitor()">BAJAR MONITOR</button>
    </div>

    <!-- PANTALLA JUMPSCARE -->
    <div id="jumpscare-screen">
        <img id="jumpscare-img" src="" alt="Jumpscare">
        <h1 style="color: red; margin-top: 15px; letter-spacing: 4px; text-shadow: 0 0 15px red;">TE HAS CONVERTIDO EN TESTIGO</h1>
        <button class="ctrl-btn" style="margin-top: 15px; background: #440000;" onclick="location.reload()">REINTENTAR NOCHE</button>
    </div>
</div>

<script>
    // URLs codificadas de los dos monstruos
    const imgBoiledOne = "https://i.postimg.cc/k4GfZ4p2/nye-je.jpg"; 
    const imgLocust = "https://i.postimg.cc/s2x0yR6v/the-locust.jpg";

    let power = 100;
    let hour = 12;
    let currentCam = 1;
    let isCamOpen = false;
    let gameOver = false;

    let doorLeft = false;
    let doorRight = false;
    let lightLeft = false;
    let lightRight = false;

    let boiledOnePos = 0; // 0 = Lejos (Cámara), 1 = Puerta, 2 = Ataque
    let locustPos = 0;

    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;

    function initAudio() {
        if (!audioCtx) audioCtx = new AudioCtx();
    }

    // Audio sintetizado: Grito agudo distorsionado
    function playScreamSound() {
        try {
            initAudio();
            const now = audioCtx.currentTime;
            
            const osc1 = audioCtx.createOscillator();
            const osc2 = audioCtx.createOscillator();
            const noiseNode = audioCtx.createBufferSource();

            osc1.type = 'sawtooth';
            osc1.frequency.setValueAtTime(1400, now);
            osc1.frequency.exponentialRampToValueAtTime(200, now + 1.8);

            osc2.type = 'square';
            osc2.frequency.setValueAtTime(1450, now);
            osc2.frequency.exponentialRampToValueAtTime(100, now + 1.8);

            const bufferSize = audioCtx.sampleRate * 1.8;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }
            noiseNode.buffer = buffer;

            const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(0.9, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 1.8);

            osc1.connect(gain);
            osc2.connect(gain);
            noiseNode.connect(gain);
            gain.connect(audioCtx.destination);

            osc1.start(now);
            osc2.start(now);
            noiseNode.start(now);

            osc1.stop(now + 1.8);
            osc2.stop(now + 1.8);
            noiseNode.stop(now + 1.8);
        } catch(e){}
    }

    function playButtonSound() {
        try {
            initAudio();
            let osc = audioCtx.createOscillator();
            let gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(180, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.08);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.08);
        } catch(e){}
    }

    function setupImages() {
        document.getElementById('monster-left').src = imgBoiledOne;
        document.getElementById('monster-right').src = imgLocust;
    }

    function toggleDoor(side) {
        if (gameOver) return;
        playButtonSound();
        if (side === 'left') {
            doorLeft = !doorLeft;
            document.getElementById('door-left').classList.toggle('closed', doorLeft);
        } else {
            doorRight = !doorRight;
            document.getElementById('door-right').classList.toggle('closed', doorRight);
        }
    }

    function toggleLight(side) {
        if (gameOver) return;
        playButtonSound();
        if (side === 'left') {
            lightLeft = !lightLeft;
            document.getElementById('light-left').classList.toggle('on', lightLeft);
            document.getElementById('monster-left').style.display = (lightLeft && boiledOnePos === 1) ? 'block' : 'none';
        } else {
            lightRight = !lightRight;
            document.getElementById('light-right').classList.toggle('on', lightRight);
            document.getElementById('monster-right').style.display = (lightRight && locustPos === 1) ? 'block' : 'none';
        }
    }

    function toggleMonitor() {
        if (gameOver) return;
        playButtonSound();
        isCamOpen = !isCamOpen;
        document.getElementById('camera-view').style.display = isCamOpen ? 'block' : 'none';
        updateCamDisplay();
    }

    function switchCam(num) {
        currentCam = num;
        playButtonSound();
        document.querySelectorAll('.cam-btn').forEach((b, i) => b.classList.toggle('active', i+1 === num));
        updateCamDisplay();
    }

    function updateCamDisplay() {
        let camImg = document.getElementById('cam-monster-img');
        if (currentCam === 1 && boiledOnePos === 0) {
            camImg.src = imgBoiledOne;
            camImg.style.display = 'block';
        } else if (currentCam === 2 && locustPos === 0) {
            camImg.src = imgLocust;
            camImg.style.display = 'block';
        } else {
            camImg.style.display = 'none';
        }
    }

    // IA de los Monstruos: Apariciones pausadas e imprevistas
    setInterval(() => {
        if (gameOver) return;

        // Aparición gradual
        if (Math.random() < 0.20) {
            if (boiledOnePos === 0) {
                boiledOnePos = 1;
            } else if (boiledOnePos === 1) {
                if (!doorLeft) boiledOnePos = 2;
                else boiledOnePos = 0;
            }
        }

        if (Math.random() < 0.20) {
            if (locustPos === 0) {
                locustPos = 1;
            } else if (locustPos === 1) {
                if (!doorRight) locustPos = 2;
                else locustPos = 0;
            }
        }

        if (lightLeft) document.getElementById('monster-left').style.display = (boiledOnePos === 1) ? 'block' : 'none';
        if (lightRight) document.getElementById('monster-right').style.display = (locustPos === 1) ? 'block' : 'none';

        if (boiledOnePos === 2 && !isCamOpen) triggerJumpscare('boiled');
        if (locustPos === 2 && !isCamOpen) triggerJumpscare('locust');

        if (isCamOpen) updateCamDisplay();
    }, 5000);

    // Sistema de Batería
    setInterval(() => {
        if (gameOver) return;

        let usage = 1;
        if (doorLeft) usage++;
        if (doorRight) usage++;
        if (lightLeft) usage++;
        if (lightRight) usage++;
        if (isCamOpen) usage++;

        power -= usage * 0.12;
        document.getElementById('power-val').innerText = Math.max(0, Math.floor(power)) + "%";
        document.getElementById('usage-val').innerText = usage > 3 ? "ALTO" : (usage > 1 ? "MEDIO" : "BAJO");

        if (power <= 0) {
            triggerJumpscare('boiled');
        }
    }, 1000);

    // Reloj
    setInterval(() => {
        if (gameOver) return;
        hour++;
        if (hour === 13) hour = 1;
        document.getElementById('hour-val').innerText = hour;
        if (hour === 6) {
            gameOver = true;
            alert("6:00 AM - HAS SOBREVIVIDO.");
            location.reload();
        }
    }, 30000);

    function triggerJumpscare(monster) {
        gameOver = true;
        playScreamSound();
        document.getElementById('jumpscare-screen').style.display = 'flex';
        document.getElementById('jumpscare-img').src = (monster === 'boiled') ? imgBoiledOne : imgLocust;
    }

    // Teclas directas
    window.addEventListener('keydown', (e) => {
        if (e.key === 'q' || e.key === 'Q') toggleLight('left');
        if (e.key === 'l' || e.key === 'L') toggleDoor('left');
        if (e.key === 'e' || e.key === 'E') toggleLight('right');
        if (e.key === 'r' || e.key === 'R') toggleDoor('right');
        if (e.key === ' ') toggleMonitor();
    });

    window.onload = setupImages;
</script>
</body>
</html>
